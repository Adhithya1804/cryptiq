# Base URL of the Cryptiq backend HTTP API (v1).
#
# Leave this blank to run the frontend with no backend connected: read screens
# render their empty states and starting an inspection reports a connection error
# instead of fabricating a result. Set it to point the app at a real deployment.
#
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#   VITE_API_BASE_URL=https://cryptiq.example.com/api/v1
#
# NEXT_PUBLIC_API_URL is accepted as an alias if that name is already exported.
# For local development, .env.development.local sets this to
# http://localhost:8000/api/v1 — no production URL is hard-coded anywhere.
VITE_API_BASE_URL=

# Optional request timeout in milliseconds (default: 20000).
VITE_API_TIMEOUT_MS=

# Only public, non-secret configuration belongs in this file. Anything bundled
# into the browser build is world-readable — API keys, GitHub tokens and the
# Gemini key live on the backend only.
