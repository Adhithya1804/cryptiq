#!/bin/bash
# ==============================================================================
# CRYPTIQ EC2 BOOTSTRAP — TERRAFORM TEMPLATE
# Runs on EC2 first boot to prepare environment, mount persistent storage,
# retrieve optional SSM secrets, start Docker Compose, and verify health.
# ==============================================================================
set -euxo pipefail

exec > >(tee -a /var/log/cloud-init-output.log) 2>&1

REGION="${aws_region}"
REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
BOOTSTRAP_LOG_GROUP="${bootstrap_log_group}"
APP_DIR="/opt/cryptiq/app"
ENV_FILE="/opt/cryptiq/.env"
DATA_MNT="/data"
COMPOSE_FILE="deploy/aws/compose/docker-compose.aws.yml"
COMPOSE_VERSION="v2.29.7"

echo "cryptiq-bootstrap: starting at $(date -u +%FT%TZ) region=$${REGION}"

# --- 1. System packages, Docker & Compose plugin ---------------------- #
dnf install -y git docker amazon-cloudwatch-agent
systemctl enable --now docker
usermod -aG docker ec2-user || true

mkdir -p /usr/local/lib/docker/cli-plugins
if ! docker compose version >/dev/null 2>&1; then
  arch="$(uname -m)"
  case "$${arch}" in
    x86_64) arch=x86_64 ;;
    aarch64) arch=aarch64 ;;
  esac
  curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
    "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$${arch}"
  chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
fi
docker compose version

# --- 2. Clone application repository ----------------------------------- #
mkdir -p /opt/cryptiq
rm -rf "$${APP_DIR}"
for attempt in 1 2 3 4 5 6; do
  if git clone --depth 1 --branch "$${REPO_REF}" "$${REPO_URL}" "$${APP_DIR}"; then
    echo "cryptiq-bootstrap: git clone succeeded on attempt $${attempt}"
    break
  fi
  echo "cryptiq-bootstrap: git clone attempt $${attempt} failed; retrying in 10s..."
  sleep 10
done
test -d "$${APP_DIR}/.git"

# Ensure deploy/aws/scripts/refresh-secrets.sh is present and executable
mkdir -p "$${APP_DIR}/deploy/aws/scripts"
cat > "$${APP_DIR}/deploy/aws/scripts/refresh-secrets.sh" << 'EOF_REFRESH'
#!/usr/bin/env bash
set -euo pipefail
REGION="$${AWS_REGION:-$${AWS_DEFAULT_REGION:-us-east-1}}"
PARAM_NAME="/cryptiq/GEMINI_API_KEY"
ENV_FILE="/opt/cryptiq/.env"
APP_DIR="/opt/cryptiq/app"
COMPOSE_FILE="deploy/aws/compose/docker-compose.aws.yml"

echo "refresh-secrets: querying SSM Parameter Store for $${PARAM_NAME} in $${REGION}..."
mkdir -p /opt/cryptiq
umask 077
: > "$${ENV_FILE}"

gemini_key="$$(aws ssm get-parameter --region "$${REGION}" --name "$${PARAM_NAME}" \
  --with-decryption --query Parameter.Value --output text 2>/dev/null || true)"

if [ -n "$${gemini_key}" ] && [ "$${gemini_key}" != "None" ]; then
  printf 'GEMINI_API_KEY=%s\n' "$${gemini_key}" >> "$${ENV_FILE}"
  echo "refresh-secrets: GEMINI_API_KEY loaded from SSM (value not logged)."
else
  echo "refresh-secrets: notice — $${PARAM_NAME} not present in SSM; AI explanation remains disabled."
fi
unset gemini_key

chmod 600 "$${ENV_FILE}"
chown root:root "$${ENV_FILE}" 2>/dev/null || true

if [ -d "$${APP_DIR}" ]; then
  cd "$${APP_DIR}"
  echo "refresh-secrets: restarting backend service..."
  docker compose -f "$${COMPOSE_FILE}" restart backend

  echo "refresh-secrets: waiting for backend health & readiness..."
  ready=0
  for attempt in $$(seq 1 30); do
    if curl -fsS -o /dev/null --max-time 5 "http://127.0.0.1:8000/health/ready" 2>/dev/null || \
       curl -fsS -o /dev/null --max-time 5 "http://127.0.0.1/api/v1/health/ready" 2>/dev/null; then
      ready=1
      echo "refresh-secrets: backend healthy and ready."
      break
    fi
    sleep 2
  done

  if [ "$${ready}" -ne 1 ]; then
    echo "refresh-secrets: WARNING backend did not become ready within 60s"
    docker compose -f "$${COMPOSE_FILE}" ps
    exit 1
  fi
  echo "refresh-secrets: SUCCESS — runtime environment refreshed, Gemini active."
fi
EOF_REFRESH
chmod +x "$${APP_DIR}/deploy/aws/scripts/refresh-secrets.sh"

# --- 3. Mount encrypted data volume at /data --------------------------- #
mkdir -p "$${DATA_MNT}"
data_dev=""
# Wait up to 60s for the secondary EBS volume attachment
for i in $(seq 1 12); do
  for dev in $(lsblk -dpno NAME,TYPE | awk '$2=="disk"{print $1}'); do
    root_dev="$(findmnt -no SOURCE / | sed 's/p\?[0-9]*$//')"
    [ "$${dev}" = "$${root_dev}" ] && continue
    if [ -z "$(lsblk -no MOUNTPOINT "$${dev}")" ]; then
      data_dev="$${dev}"
      break 2
    fi
  done
  sleep 5
done

if [ -n "$${data_dev}" ]; then
  echo "cryptiq-bootstrap: formatting and mounting persistent data volume $${data_dev} to $${DATA_MNT}"
  if ! blkid "$${data_dev}"; then
    mkfs.xfs -q "$${data_dev}"
  fi
  uuid="$(blkid -s UUID -o value "$${data_dev}")"
  grep -q "$${uuid}" /etc/fstab || echo "UUID=$${uuid} $${DATA_MNT} xfs defaults,nofail 0 2" >> /etc/fstab
  mount -a
else
  echo "cryptiq-bootstrap: WARNING no dedicated data volume found; SQLite will live on root volume"
fi

# Ensure non-root backend user (uid 1001) owns /data
mkdir -p "$${DATA_MNT}"
chown -R 1001:1001 "$${DATA_MNT}"

# --- 4. Secrets from SSM Parameter Store ------------------------------- #
mkdir -p /opt/cryptiq
umask 077
: > "$${ENV_FILE}"
gemini_key="$(aws ssm get-parameter --region "$${REGION}" --name /cryptiq/GEMINI_API_KEY \
  --with-decryption --query Parameter.Value --output text 2>/dev/null || true)"
if [ -n "$${gemini_key}" ] && [ "$${gemini_key}" != "None" ]; then
  printf 'GEMINI_API_KEY=%s\n' "$${gemini_key}" >> "$${ENV_FILE}"
  echo "cryptiq-bootstrap: GEMINI_API_KEY loaded from SSM (value not logged)"
else
  echo "cryptiq-bootstrap: Gemini key not configured; AI explanation path disabled"
fi
unset gemini_key
chmod 600 "$${ENV_FILE}"
chown root:root "$${ENV_FILE}"

# --- 5. CloudWatch agent for bootstrap logs ---------------------------- #
cat > /opt/aws/amazon-cloudwatch-agent/etc/cryptiq.json <<CW_CONFIG
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "$${BOOTSTRAP_LOG_GROUP}",
            "log_stream_name": "{instance_id}/cloud-init",
            "retention_in_days": 3
          }
        ]
      }
    }
  }
}
CW_CONFIG
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/cryptiq.json || true

# --- 6. Bring up the demo stack ---------------------------------------- #
cd "$${APP_DIR}"
export AWS_REGION="$${REGION}"
docker compose -f "$${COMPOSE_FILE}" up -d --build

# --- 7. Health gate ---------------------------------------------------- #
ok() { curl -fsS -o /dev/null --max-time 5 "$1"; }
for probe in \
  "http://localhost/healthz|nginx" \
  "http://localhost/api/v1/health|backend liveness" \
  "http://localhost/api/v1/health/ready|backend readiness" ; do
  url="$${probe%%|*}"
  name="$${probe##*|}"
  for attempt in $(seq 1 60); do
    if ok "$${url}"; then
      echo "cryptiq-bootstrap: $${name} OK ($${url})"
      break
    fi
    if [ "$${attempt}" -eq 60 ]; then
      echo "cryptiq-bootstrap: FAILED $${name} never became healthy ($${url})"
      docker compose -f "$${COMPOSE_FILE}" ps
      exit 1
    fi
    sleep 5
  done
done

echo "cryptiq-bootstrap: complete at $(date -u +%FT%TZ)"
