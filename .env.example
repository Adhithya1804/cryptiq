# Cryptiq Docker stack configuration.
#
# Copy to ./.env and edit. docker-compose.yml reads ./.env for both compose
# variable interpolation and the backend container's environment. ./.env is
# git-ignored and is NEVER copied into an image — values are injected into
# containers at runtime only.
#
#   cp .env.example .env
#
# Nothing here is required for the default SQLite demo: the stack starts with
# these defaults. Secrets (Gemini key, GitHub token, DB password) stay blank
# unless you set them, and never reach the browser bundle.

# ------------------------------------------------------------------ backend ---

# Host port for direct API/CLI access to the backend (container port is always
# 8000; the frontend proxies internally regardless). Change if 8000 is taken.
BACKEND_HOST_PORT=8000

# Environment name (affects nothing security-sensitive; kept for parity).
ENVIRONMENT=production

# Database. Left unset here because docker-compose.yml sets it per service
# (SQLite by default; the postgres override sets a postgresql+psycopg URL).
# DATABASE_URL=sqlite:////data/cryptiq.db

# Browser origins allowed to call the API directly (comma-separated). The
# frontend proxies /api same-origin, so this only needs the frontend origin.
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Run the in-process scan worker inside the backend container. Keep "true"
# unless you run a separate worker.
RUN_WORKER=true

# GitHub ingestion. A token is OPTIONAL — it raises the rate limit and reaches
# private repos. Leave blank for public repositories like the acceptance repo.
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=30

# Ingestion / analysis bounds (defaults match the non-Docker app).
MAX_ARCHIVE_BYTES=262144000
MAX_EXTRACTED_BYTES=524288000
MAX_FILES=20000
MAX_FILE_BYTES=5242880
SCAN_TIMEOUT_SECONDS=300

# Gemini explanation layer. OPTIONAL and server-side only. With no key the
# "Explain with AI" control returns a controlled AI_EXPLANATION_UNAVAILABLE
# state and every finding stays fully usable. NEVER commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1500

# Deterministic engine version stamps — change only with the engine.
PARSER_VERSION=python-ast-1
RULESET_VERSION=0.3.0
PQC_RULESET_VERSION=0.2.0

# ----------------------------------------------------------------- postgres ---
# Used only with docker-compose.postgres.yml. Change the password for anything
# beyond a laptop demo; it is never baked into an image.
POSTGRES_PASSWORD=cryptiq

# ----------------------------------------------------------------- frontend ---
# The frontend API base URL is a BUILD arg (baked into the static bundle), set
# in docker-compose.yml to the same-origin path "/api/v1". Override at build
# time for a split-origin deployment:
#   docker compose build --build-arg VITE_API_BASE_URL=https://api.example.com/api/v1 frontend
