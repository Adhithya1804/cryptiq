ENVIRONMENT=development

DATABASE_URL=sqlite:///./cryptiq.db

GITHUB_API_URL=https://api.github.com
# Optional. Raises the GitHub rate limit and reaches private repositories.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=30

MAX_ARCHIVE_BYTES=262144000
MAX_EXTRACTED_BYTES=524288000
MAX_FILES=20000
MAX_FILE_BYTES=5242880

SCAN_TIMEOUT_SECONDS=300

# Browser origins allowed to call the API (comma-separated). Defaults to the
# Vite dev server. "*" is honoured only for local throwaway use.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Run the in-process scan worker alongside the API. Disable to run a worker
# process separately.
RUN_WORKER=true

# Optional. When set, the /findings/{id}/explanation endpoint generates a
# natural-language explanation through Gemini. The key stays server-side and
# is never sent to the browser. Unset: explanations are reported unavailable
# and every finding stays fully usable without them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1500

PARSER_VERSION=python-ast-1
RULESET_VERSION=0.3.0
PQC_RULESET_VERSION=0.2.0
